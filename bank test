<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Vietnam Retail Banking Competitive Intelligence Dashboard</title>
<style>
  :root {
    --navy:#06162f;
    --navy-2:#0b2347;
    --panel:rgba(6,22,47,.82);
    --panel-2:rgba(10,31,61,.92);
    --red:#e31b23;
    --red-2:#ff3b30;
    --text:#f7f9fc;
    --muted:#aab8ce;
    --line:rgba(255,255,255,.13);
    --good:#58d68d;
    --warn:#f7c948;
    --bad:#ff6b6b;
    --info:#6da8ff;
  }
  * { box-sizing:border-box; }
  body {
    margin:0;
    background:var(--navy);
    color:var(--text);
    font-family:Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  }
  .hero {
    min-height: 310px;
    background:
      linear-gradient(90deg, rgba(2,11,29,.94) 0%, rgba(4,19,47,.78) 42%, rgba(4,19,47,.28) 72%, rgba(4,19,47,.18) 100%),
      url("data:image/jpeg;base64,") center 57% / cover no-repeat;
    position:relative;
    border-bottom:1px solid rgba(255,255,255,.12);
    overflow:hidden;
  }
  .hero:after {
    content:"";
    position:absolute; right:-90px; top:-90px; width:290px; height:220px;
    background:linear-gradient(135deg, rgba(227,27,35,.95), rgba(145,0,0,.78));
    transform:rotate(14deg);
    border-left:4px solid #fff;
    opacity:.92;
  }
  .hero-inner {
    position:relative; z-index:2; max-width:1450px; margin:auto; padding:42px 34px 34px;
  }
  .eyebrow { color:#ff5860; font-weight:800; letter-spacing:.13em; font-size:12px; text-transform:uppercase; }
  h1 { margin:12px 0 8px; font-size:clamp(32px,5vw,68px); line-height:.98; max-width:860px; }
  h1 span { color:var(--red-2); }
  .subtitle { max-width:780px; color:#e9eef7; font-size:18px; line-height:1.55; font-weight:600; }
  .scope-badge {
    display:inline-flex; margin-top:18px; padding:9px 14px; border:1px solid rgba(255,255,255,.25);
    border-radius:999px; background:rgba(0,0,0,.22); font-size:13px;
  }

  .nav {
    position:sticky; top:0; z-index:20; background:rgba(4,14,33,.96); backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner { max-width:1450px; margin:auto; display:flex; gap:6px; padding:10px 24px; overflow:auto; }
  .nav button {
    border:0; background:transparent; color:#c9d4e6; padding:10px 14px; border-radius:8px;
    white-space:nowrap; cursor:pointer; font-weight:700;
  }
  .nav button.active,.nav button:hover { background:rgba(227,27,35,.15); color:#fff; }

  .container { max-width:1450px; margin:auto; padding:26px 24px 60px; }
  .section { display:none; }
  .section.active { display:block; }
  .section-title { display:flex; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:16px; }
  .section-title h2 { margin:0; font-size:28px; }
  .section-title p { margin:4px 0 0; color:var(--muted); }
  .tag { border:1px solid var(--line); color:#cdd7e6; padding:6px 10px; border-radius:999px; font-size:12px; }

  .grid { display:grid; gap:14px; }
  .g4 { grid-template-columns:repeat(4,minmax(0,1fr)); }
  .g3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .g2 { grid-template-columns:repeat(2,minmax(0,1fr)); }
  @media(max-width:1050px) { .g4,.g3 { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:680px) { .g4,.g3,.g2 { grid-template-columns:1fr; } }

  .card {
    background:linear-gradient(180deg, rgba(15,43,82,.92), rgba(7,25,52,.94));
    border:1px solid var(--line); border-radius:16px; padding:18px; box-shadow:0 16px 35px rgba(0,0,0,.15);
  }
  .kpi-label { color:var(--muted); text-transform:uppercase; letter-spacing:.08em; font-size:11px; font-weight:800; }
  .kpi-value { font-size:32px; font-weight:900; margin-top:7px; }
  .kpi-note { font-size:12px; color:var(--muted); margin-top:8px; }
  .accent { color:var(--red-2); }
  .good { color:var(--good); } .warn{color:var(--warn)} .bad{color:var(--bad)} .info{color:var(--info)}

  .panel-title { font-weight:850; margin-bottom:12px; }
  .bar-row { display:grid; grid-template-columns:150px 1fr 52px; gap:10px; align-items:center; margin:10px 0; }
  .bar-track { height:10px; background:rgba(255,255,255,.08); border-radius:999px; overflow:hidden; }
  .bar-fill { height:100%; background:linear-gradient(90deg,#ff3b30,#ff7b72); border-radius:999px; }
  .small { font-size:12px; color:var(--muted); }

  table { width:100%; border-collapse:collapse; font-size:13px; }
  th,td { padding:11px 10px; border-bottom:1px solid rgba(255,255,255,.08); text-align:left; vertical-align:top; }
  th { color:#cfd9e9; font-size:11px; text-transform:uppercase; letter-spacing:.06em; position:sticky; top:50px; background:#0a1d3a; }
  .table-wrap { overflow:auto; max-height:560px; border:1px solid var(--line); border-radius:14px; }
  .status { display:inline-flex; align-items:center; gap:6px; border-radius:999px; padding:5px 9px; font-size:11px; font-weight:800; background:rgba(255,255,255,.07); }
  .dot { width:7px; height:7px; border-radius:50%; background:var(--warn); }

  .filters { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
  select,input {
    background:#0a1e3d; border:1px solid var(--line); color:#fff; padding:10px 12px; border-radius:9px; outline:none;
  }

  .heatmap { display:grid; grid-template-columns:180px repeat(6,minmax(90px,1fr)); gap:4px; min-width:820px; }
  .hm-head,.hm-label { padding:10px; font-size:12px; font-weight:800; }
  .hm-cell {
    min-height:45px; display:flex; align-items:center; justify-content:center; border-radius:7px;
    font-weight:900; border:1px solid rgba(255,255,255,.07);
  }
  .score-1 { background:#273755; } .score-2{background:#35466b} .score-3{background:#615060}
  .score-4{background:#91404c} .score-5{background:#c52a35}

  .timeline-item { padding:14px 0 14px 18px; border-left:2px solid rgba(255,255,255,.14); position:relative; }
  .timeline-item:before { content:""; width:9px; height:9px; border-radius:50%; background:var(--red-2); position:absolute; left:-5.5px; top:20px; }
  .timeline-item b { display:block; margin-bottom:4px; }
  .timeline-item p { margin:4px 0; color:#c9d4e5; }

  .alert {
    display:flex; gap:12px; padding:14px; background:rgba(227,27,35,.09); border:1px solid rgba(227,27,35,.28);
    border-radius:12px; margin-bottom:10px;
  }
  .alert strong { display:block; margin-bottom:4px; }
  .footer { color:#7f91ad; text-align:center; padding-top:36px; font-size:12px; }
</style>

