let productTab="Landscape";
function badge(text, cls="info"){return `<span class="prod-badge ${cls}">${text}</span>`}
function productTable(headers, rows){return `<div class="table-wrap" style="max-height:none"><table><thead><tr>${headers.map(h=>`<th>${h}</th>`).join("")}</tr></thead><tbody>${rows.join("")}</tbody></table></div>`}
function trendBlock(key){const arr=productTrends[key]||[];return `<div class="card" style="margin-top:14px"><div class="panel-title">New Trend</div>${arr.length?arr.map(c=>`<div class="prod-radar"><div style="display:flex;justify-content:space-between;gap:12px"><div><b>${c.bank}</b> — ${c.item}<div style="margin-top:5px">${c.trend}: <span class="small">${c.prev}</span> → ${c.curr}</div><div class="small" style="margin-top:6px">${c.date}</div></div>${badge(c.severity,c.severity==="Major"?"bad":c.severity==="Significant"?"warn":"info")}</div></div>`).join(""):`<div class="small">No validated trend loaded.</div>`}</div>`}
function mutualFundLineChart(){
 const series=[{k:"Vietcombank",label:"Vietcombank"},{k:"Techcombank",label:"Techcombank"},{k:"HSBC",label:"HSBC"}], W=920,H=330,pad=46,max=3;
 const xs=fundGrowth.map((d,i)=>pad+i*(W-pad*2)/(fundGrowth.length-1)); const y=v=>H-pad-(v/max)*(H-pad*2);
 const grid=[0,1,2,3].map(v=>`<line x1="${pad}" y1="${y(v)}" x2="${W-pad}" y2="${y(v)}" stroke="rgba(255,255,255,.10)"/><text x="10" y="${y(v)+4}" fill="#aab8ce" font-size="11">${v}%</text>`).join("");
 const lines=series.map((s,si)=>{const pts=fundGrowth.map((d,i)=>`${xs[i]},${y(d[s.k])}`).join(' '); return `<polyline points="${pts}" fill="none" stroke="${['#6da8ff','#58d68d','#f7c948'][si]}" stroke-width="3"/>`+fundGrowth.map((d,i)=>`<circle cx="${xs[i]}" cy="${y(d[s.k])}" r="4" fill="${['#6da8ff','#58d68d','#f7c948'][si]}"/>`).join('')}).join('');
 const labels=fundGrowth.map((d,i)=>`<text x="${xs[i]}" y="${H-14}" text-anchor="middle" fill="#aab8ce" font-size="11">${d.month}</text>`).join('');
 return `<div class="card"><div class="small" style="margin-bottom:10px">Monthly growth % · illustrative sample · 15-bank universe, available sample series shown</div><svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto">${grid}${lines}${labels}</svg><div class="small">Vietcombank · Techcombank · HSBC. Remaining banks: needs validation before plotting.</div></div>`;
}
function renderProduct(){
 const tabs=document.getElementById("productSubtabs"), out=document.getElementById("productContent"); if(!tabs||!out)return;
 document.getElementById('prodTracked').textContent='15'; document.getElementById('prodNew').textContent='—'; document.getElementById('prodAlerts').textContent='4';
 tabs.innerHTML=productTabs.map(t=>`<button class="subtab ${t===productTab?"active":""}" onclick="productTab='${t}';renderProduct()">${t}</button>`).join("");
 if(productTab==="Landscape"){
  out.innerHTML=`<div class="grid g3"><div class="prod-stat"><div class="kpi-label">Credit Cards</div><div class="n">15</div><div class="small">All banks in scope</div></div><div class="prod-stat"><div class="kpi-label">FX</div><div class="n">15</div><div class="small">All banks in scope</div></div><div class="prod-stat"><div class="kpi-label">Mutual Funds</div><div class="n">15</div><div class="small">All banks in scope</div></div></div><div class="card" style="margin-top:12px"><div class="panel-title">Coverage by bank universe</div><div class="small">${bankNames.join(' · ')}</div></div>`;
 } else if(productTab==="Credit Cards"){
  out.innerHTML=productTable(["Bank","Card","Annual Fee","Cashback","Rewards","Lounge","Digital","Status"],productCards.map(c=>`<tr><td>${c.bank}</td><td>${c.card}</td><td>${c.fee}</td><td>${c.cashback}</td><td>${c.rewards}</td><td>${c.lounge}</td><td>${c.digital}</td><td>${badge(c.status,c.status==="Changed"?"warn":"info")}</td></tr>`))+trendBlock("Credit Cards");
 } else if(productTab==="FX Benchmark"){
  const ranked=productFx.filter(f=>f.spread!==null).sort((a,b)=>a.spread-b.spread); ranked.forEach((f,i)=>f.rank=i+1);
  out.innerHTML=`<div class="small" style="margin-bottom:10px">USD/VND · available sample rows ranked by tightest spread; remaining banks retained as Needs validation</div>`+productTable(["Rank","Bank","Buy Rate","Sell Rate","Spread","Status"],productFx.map(f=>`<tr><td>${f.rank?badge('#'+f.rank,f.rank===1?'good':'info'):'—'}</td><td>${f.bank}</td><td>${f.buy?f.buy.toLocaleString():'—'}</td><td>${f.sell?f.sell.toLocaleString():'—'}</td><td>${f.spread??'—'}</td><td>${badge(f.status,f.status==='Sample'?'info':'warn')}</td></tr>`))+trendBlock("FX Benchmark");
 } else if(productTab==="Mutual Funds"){
  out.innerHTML=mutualFundLineChart()+trendBlock("Mutual Funds")+productTable(["Bank","Coverage status"],bankNames.map(b=>`<tr><td>${b}</td><td>${["Vietcombank","Techcombank","HSBC"].includes(b)?badge('Sample series','info'):badge('Needs validation','warn')}</td></tr>`));
 }
}
renderProduct();

const capBanks=bankNames;
const capPillars=[
{id:'onboarding',name:'Onboarding & eKYC',scores:{'HSBC':4,'Std Chartered':4,'UOB':3,'ACB':4,'VPBank':4,'Techcombank':4},priority:'low',rows:[['Instant account opening',{'HSBC':'Yes, ~10 min','Std Chartered':'Yes, ~15 min','UOB':'Yes, ~15 min','ACB':'Yes, ~7 min','VPBank':'Yes, ~5 min','Techcombank':'Yes, ~5 min'}],['Biometric / VNeID login',{'HSBC':'Biometric only','Std Chartered':'Biometric only','UOB':'Biometric only','ACB':'VNeID-linked','VPBank':'VNeID-linked','Techcombank':'VNeID-linked'}],['Video-assisted onboarding',{'HSBC':'No','Std Chartered':'No','UOB':'No','ACB':'Yes','VPBank':'Yes','Techcombank':'Yes'}]],action:'Pilot VNeID single-tap login to close the last onboarding-speed gap versus local leaders.'},
{id:'mobile',name:'Core mobile experience',scores:{'HSBC':3,'Std Chartered':3,'UOB':3,'ACB':4,'VPBank':5,'Techcombank':5},priority:'high',rows:[['Budgeting / PFM tools',{'HSBC':'Not available','Std Chartered':'Not available','UOB':'Not available','ACB':'Basic','VPBank':'Full','Techcombank':'Full'}],['In-app AI assistant',{'HSBC':'Basic FAQ bot','Std Chartered':'Basic FAQ bot','UOB':'Basic FAQ bot','ACB':'Guided assistant','VPBank':'Advanced, personalized','Techcombank':'Advanced, personalized'}],['App store rating',{'HSBC':'~3.5','Std Chartered':'~3.6','UOB':'~3.7','ACB':'~4.2','VPBank':'~4.5','Techcombank':'~4.6'}]],action:'Fast-follow a PFM/budgeting module and upgrade the in-app assistant; treat as a near-term UX priority.'},
