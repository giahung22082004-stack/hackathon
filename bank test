.cap-detail-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}.cap-detail-title{font-weight:850}
.cap-prio{font-size:11px;padding:4px 9px;border-radius:999px}.cap-prio.high{background:rgba(255,107,107,.16);color:var(--bad)}.cap-prio.medium{background:rgba(247,201,72,.15);color:var(--warn)}.cap-prio.low{background:rgba(88,214,141,.15);color:var(--good)}
.cap-action{border-top:1px solid var(--line);margin-top:10px;padding-top:10px}.cap-action b{color:var(--muted);font-size:11px;text-transform:uppercase}
.cap-feed{padding:10px 0;border-bottom:1px solid rgba(255,255,255,.07)}.cap-feed:last-child{border-bottom:0}
@media(max-width:720px){.module-head{align-items:flex-start;flex-direction:column}.module-kpis{width:100%;justify-content:space-between}.module-kpis div{text-align:left}}
</style>

</head>
