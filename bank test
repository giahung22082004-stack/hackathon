<script>
const banks = [{"name": "Vietcombank", "type": "Domestic"}, {"name": "VietinBank", "type": "Domestic"}, {"name": "BIDV", "type": "Domestic"}, {"name": "Techcombank", "type": "Domestic"}, {"name": "VPBank", "type": "Domestic"}, {"name": "MBBank", "type": "Domestic"}, {"name": "ACB", "type": "Domestic"}, {"name": "HSBC", "type": "Foreign"}, {"name": "Standard Chartered", "type": "Foreign"}, {"name": "UOB", "type": "Foreign"}, {"name": "Shinhan", "type": "Foreign"}, {"name": "Woori", "type": "Foreign"}, {"name": "CIMB", "type": "Foreign"}, {"name": "Hong Leong", "type": "Foreign"}, {"name": "Public Bank", "type": "Foreign"}];
const tbody = document.querySelector("#bankTable tbody");
function renderBanks(){
  const q = document.querySelector("#bankSearch").value.toLowerCase();
  const t = document.querySelector("#typeFilter").value;
  const rows = banks.filter(b => (t==="all"||b.type===t) && b.name.toLowerCase().includes(q));
  tbody.innerHTML = rows.map((b,i)=>`<tr><td>${i+1}</td><td><strong>${b.name}</strong></td><td>${b.type}</td><td>${b.type==="Domestic"?"Core domestic peer":"Foreign retail peer / watch"}</td><td><span class="status"><span class="dot"></span> Needs validation</span></td></tr>`).join("");
}
document.querySelector("#bankSearch").addEventListener("input",renderBanks);
document.querySelector("#typeFilter").addEventListener("change",renderBanks);
renderBanks();

document.querySelectorAll(".nav button").forEach(btn=>{
  btn.addEventListener("click",()=>{
    document.querySelectorAll(".nav button").forEach(b=>b.classList.remove("active"));
    document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
    btn.classList.add("active");
    document.getElementById(btn.dataset.tab).classList.add("active");
  });
});

const pillars=["Onboarding & eKYC","Core Mobile","Payments","Product Breadth","AI & Personalization","Customer Servicing"];
const hm=document.getElementById("heatmap");
hm.innerHTML = `<div class="hm-head">Bank</div>`+pillars.map(p=>`<div class="hm-head">${p}</div>`).join("");
banks.forEach((b,idx)=>{
  hm.innerHTML += `<div class="hm-label">${b.name}</div>`;
  pillars.forEach((p,j)=>{
    const score = ((idx*2+j*3)%5)+1; // DEMO ONLY
    hm.innerHTML += `<div class="hm-cell score-${score}" title="Demo placeholder — replace with evidence-backed score">${score}</div>`;
  });
});
</script>

